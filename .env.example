# Copy to .env (git-ignored). Both npm start and npm run pull read it.

# Where your data is kept. Outside this folder; the default is ~/.battlestation-jira
BATTLESTATION_DATA_DIR=
# BATTLESTATION_PORT=4757

# Your Jira site.
JIRA_BASE_URL=https://your-site.atlassian.net

# Jira Cloud: your email and an API token (id.atlassian.com, Security, API tokens).
JIRA_EMAIL=
JIRA_API_TOKEN=

# Jira Data Center instead: a personal access token (your profile, Personal Access Tokens).
# JIRA_PAT=

# Only needed when it cannot be told from the above: cloud or datacenter.
# JIRA_DEPLOYMENT=
